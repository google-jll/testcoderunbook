# =====================================================================
# Sample terraform.tfvars for NCC Mesh Full Mesh Example
# Copy this file to terraform.tfvars and update values for your environment
# =====================================================================

# Required: The GCP project where the hub and spoke VPCs will be created
project_id = "your-gcp-project-id"

# Optional: Region for spoke VPC subnets (default: us-central1)
region = "us-central1"

# Optional: NCC Hub Name
ncc_hub_name = "example-mesh-hub"

# Optional: List of external project IDs to auto-accept when spokes attach later
auto_accept_projects = [
  # "workload-project-1",
  # "workload-project-2",
]
