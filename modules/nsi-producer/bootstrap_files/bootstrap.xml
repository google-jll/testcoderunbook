  <devices>
    <entry name="localhost.localdomain">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1">
              <layer3>
                <dhcp-client>
                  <enable>yes</enable>
                </dhcp-client>
              </layer3>
            </entry>
          </ethernet>
          <loopback>
            <units>
              <entry name="loopback.1">
                <adjust-tcp-mss>
                  <enable>no</enable>
                </adjust-tcp-mss>
